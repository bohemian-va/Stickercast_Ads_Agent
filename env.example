# Copy this file to .env and set your own values.
# .env is gitignored and must never be committed.

# API key that protects every write endpoint. Choose a strong secret.
MUTATION_API_KEY=your-secret-key-here

# Absolute path to your google-ads.yaml credentials file.
# If unset, the server looks for google-ads.yaml in the working directory.
GOOGLE_ADS_YAML=/absolute/path/to/google-ads.yaml
